{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npx tsc --noEmit)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run test:e2e:mocked)",
      "Bash(npm run test:e2e:mocked:mobile)",
      "Bash(npx playwright test *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": ["Read(**/.env*)"]
  }
}
